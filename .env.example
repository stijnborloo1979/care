# Kopieer naar .env voor lokaal werken. In productie zet je dezelfde namen
# in Cloudflare Pages -> Settings -> Variables and Secrets.
# Nooit de service_role key hier of in een VITE_-variabele.

# Verplicht — Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Pushmeldingen — de publieke VAPID-sleutel (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Videobellen — optioneel; zonder TURN werkt bellen meestal alleen op wifi
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Adres achter "Vraag een prijs aan" op /prijzen (woonzorgcentra)
VITE_CONTACT_EMAIL=
